####
# This Dockerfile is used in order to build a container that runs the Quarkus application in native (no JVM) mode.
# It uses a micro base image, tuned for Quarkus native executables.
# It reduces the size of the resulting container image.
# Check https://quarkus.io/guides/quarkus-runtime-base-image for further information about this image.
#
# Before building the container image run:
#
# ./gradlew build -Dquarkus.native.enabled=true
#
# Then, build the image with:
#
# docker build -f src/main/docker/Dockerfile.native-micro -t quarkus/application-quarkus .
#
# Then run the container using:
#
# docker run -i --rm -p 8080:8080 quarkus/application-quarkus
#
###
FROM quay.io/quarkus/quarkus-micro-image:2.0
WORKDIR /work/
RUN chown 1001 /work \
    && chmod "g+rwX" /work \
    && chown 1001:root /work
COPY --chown=1001:root build/*-runner /work/application

EXPOSE 8080
USER 1001

# Intentionally no HEALTHCHECK here: quarkus-micro-image is built on ubi-micro, a
# distroless-style image with no package manager and no shell utilities (no curl, no
# wget, not even a shell). A HEALTHCHECK CMD referencing a missing binary would fail to
# execute at all, and Docker would report the container as permanently "unhealthy" (or
# the check would just hang), which is worse than having no healthcheck. If a healthcheck
# is needed for this variant in the future, it would require either switching to a base
# image that ships an HTTP client, or adding a tiny statically linked probe binary
# alongside the native executable.
ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
